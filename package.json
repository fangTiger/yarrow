{
  "name": "sanyi",
  "version": "0.1.0",
  "private": true,
  "description": "三易：一问三家的中式命理",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "node --import tsx scripts/compile-contracts.ts",
    "contracts:build": "cd contracts && /Users/captain/.foundry/bin/forge build",
    "deploy:yijing": "npm run contracts:build && node --env-file=.env --import tsx scripts/deploy-arc-testnet.ts",
    "deploy:yijing:fresh": "npm run contracts:build && node --env-file=.env --import tsx scripts/deploy-arc-testnet.ts --fresh",
    "e2e:yijing": "node --env-file=.env --import tsx scripts/run-arc-e2e.ts",
    "agent:check": "node --env-file=.env --import tsx scripts/check-deepseek-provider.ts",
    "agent:check:anthropic": "node --import tsx scripts/check-anthropic-provider.ts",
    "e2e:agent": "node --env-file=.env --import tsx scripts/run-agent-e2e.ts",
    "e2e:agent:audit": "node --env-file=.env --import tsx scripts/run-agent-e2e.ts --audit-round",
    "e2e:agent:deepseek": "node --env-file=.env --import tsx scripts/run-agent-e2e.ts --audit-round --deepseek",
    "e2e:quorum": "node --env-file=.env --import tsx scripts/run-quorum-e2e.ts",
    "e2e:validation": "node --env-file=.env --import tsx scripts/run-validation-e2e.ts",
    "e2e:seal": "node --env-file=.env --import tsx scripts/run-seal-demo.ts",
    "replay:walk-forward": "node --env-file=.env --import tsx scripts/run-walk-forward.ts",
    "replay:deepseek:calibrate": "node --env-file=.env --import tsx scripts/run-deepseek-replay.ts --mode=calibrate",
    "replay:difficulty:preflight": "node --import tsx scripts/preflight-difficulty-calibration.ts",
    "replay:deepseek:full": "node --env-file=.env --import tsx scripts/run-deepseek-replay.ts --mode=full",
    "replay:deepseek:ablation": "node --env-file=.env --import tsx scripts/run-deepseek-ablation.ts",
    "replay:ablation": "node --import tsx scripts/run-ablation.ts",
    "frontend:build": "node --env-file-if-exists=.env --import tsx scripts/build-frontend.ts",
    "frontend:dev": "npm run frontend:build && node --env-file=.env --import tsx src/frontend/server.ts",
    "frontend:start": "node --env-file=.env --import tsx src/frontend/server.ts",
    "frontend:secrets": "node --env-file=.env --import tsx scripts/check-frontend-secrets.ts",
    "demo:rehearse": "node --import tsx scripts/rehearse-demo.ts --mode=mock",
    "probe:readonly": "node --import tsx scripts/probe-readonly.ts",
    "probe:arc": "npm run contracts:compile && node --import tsx scripts/run-arc-probe.ts",
    "probe:agent-count": "node --import tsx scripts/probe-agent-count.ts",
    "e2e:agent-count": "node --env-file=.env --import tsx scripts/run-agent-count-e2e.ts",
    "font:charset": "node --import tsx scripts/font-charset.ts",
    "font:subset": ".venv-tools/bin/python scripts/subset-sanyi-font.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.101.1",
    "ajv": "^8.20.0",
    "lunar-javascript": "^1.7.7",
    "react": "18",
    "react-dom": "18",
    "viem": "^2.53.1",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "solc": "0.8.30",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
